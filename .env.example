# Copier en .env (jamais commité) et adapter.

# --- Base locale : `pnpm db:local` démarre PostgreSQL sans Docker d'après DATABASE_URL ---

# --- API ---
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://benskin:change-me-local@localhost:55432/benskin_impact?schema=public
# Redis : nécessaire à partir de la phase notifications/jobs (BullMQ)
# REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:4200

# JWT : secrets longs et aléatoires (openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# OTP : en développement le code est journalisé au lieu d'être envoyé par SMS
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DEV_LOG=true
OTP_HMAC_SECRET=change-me-otp-hmac-secret-at-least-32-chars

# Empreinte des adresses IP pour l'audit (on ne stocke jamais l'IP en clair)
IP_HASH_SECRET=change-me-ip-hash-secret-at-least-32-chars

# Secret ajouté au hachage Argon2 des PIN (ne jamais changer sans plan de migration)
PIN_PEPPER=change-me-pin-pepper-at-least-32-chars

# Documents KYC : stockage privé chiffré (AES-256-GCM) et URLs d'accès temporaires signées
DOCUMENT_STORAGE_DIR=../../.data/documents
# 32 octets aléatoires en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=change-me-32-bytes-base64
FILE_URL_SECRET=change-me-file-url-secret-at-least-32-chars
KYC_DOCUMENT_MAX_BYTES=5000000

# Derrière Nginx en production : TRUST_PROXY=true
TRUST_PROXY=false
SWAGGER_ENABLED=false
