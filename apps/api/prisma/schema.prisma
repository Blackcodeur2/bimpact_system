// BENSKIN IMPACT — schéma de données (phases 2 à 4 : identité, RBAC, audit, ledger, wallet, idempotence).
// Conventions : UUID, snake_case en base, created_at/updated_at, montants en NUMERIC (jamais de float).
// Les garanties d'intégrité financière (immutabilité, équilibre débit/crédit) sont renforcées
// par des triggers PostgreSQL dans la migration `ledger_integrity`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identité ───────────────────────────────

enum UserKind {
  MEMBER // conducteur / bénéficiaire / entrepreneur (application mobile)
  STAFF // back-office
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  CLOSED
}

enum KycStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  phone            String     @unique // format E.164, ex. +237612345678
  kind             UserKind   @default(MEMBER)
  status           UserStatus @default(PENDING_VERIFICATION)
  pinHash          String?    @map("pin_hash")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  phoneVerifiedAt  DateTime?  @map("phone_verified_at")
  lastLoginAt      DateTime?  @map("last_login_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  profile    Profile?
  roles      UserRole[]
  sessions   Session[]
  devices    Device[]
  consents   Consent[]
  wallet     Wallet?
  kycProfile KycProfile?

  paymentIntents   PaymentIntent[]
  notifications    Notification[]
  contributionPlan ContributionPlan?
  contributions    Contribution[]
  drawEntries      DrawEntry[]
  beneficiary      Beneficiary?

  lessonProgress   UserLessonProgress[]
  quizSubmissions  QuizSubmission[]
  certifications   Certification[]
  projects         Project[]
  accidentClaims   AccidentClaim[]
  jobApplications  JobApplication[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  userId    String    @id @map("user_id") @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  city      String
  zone      String?
  avatarKey String?   @map("avatar_key")
  kycStatus KycStatus @default(NOT_STARTED) @map("kyc_status")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([city])
  @@index([kycStatus])
  @@map("profiles")
}

model Consent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String // TERMS, PRIVACY, PROGRAM_RULES
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type, version])
  @@map("consents")
}

// ─────────────────────────────── KYC ───────────────────────────────
// Circuit : NOT_STARTED → DRAFT → SUBMITTED → UNDER_REVIEW → APPROVED | REJECTED | DRAFT (complément demandé).
// profiles.kyc_status reste un miroir de kyc_profiles.status, mis à jour dans la même transaction.

enum KycIdDocumentType {
  CNI // carte nationale d'identité
  PASSPORT
  RECEIPT // récépissé de demande de CNI
}

enum KycDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE
  VEHICLE_REGISTRATION
  DRIVING_LICENSE
}

enum KycDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
  REPLACED
}

enum KycReviewDecision {
  APPROVED
  REJECTED
  MORE_INFO_REQUESTED
}

enum VehicleOwnership {
  OWNER
  RENTED
  THIRD_PARTY
}

model KycProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  status             KycStatus          @default(DRAFT)
  firstName          String?            @map("first_name")
  lastName           String?            @map("last_name")
  birthDate          DateTime?          @map("birth_date") @db.Date
  idDocumentType     KycIdDocumentType? @map("id_document_type")
  idDocumentNumber   String?            @map("id_document_number")
  idDocumentExpiry   DateTime?          @map("id_document_expiry") @db.Date
  city               String?
  district           String?
  addressHint        String?            @map("address_hint")
  vehiclePlate       String?            @map("vehicle_plate")
  vehicleModel       String?            @map("vehicle_model")
  vehicleOwnership   VehicleOwnership?  @map("vehicle_ownership")
  submissionCount    Int                @default(0) @map("submission_count")
  submittedAt        DateTime?          @map("submitted_at")
  reviewerId         String?            @map("reviewer_id") @db.Uuid
  reviewStartedAt    DateTime?          @map("review_started_at")
  reviewedAt         DateTime?          @map("reviewed_at")
  /// Motif visible par le membre (refus ou complément demandé).
  lastDecisionReason String?            @map("last_decision_reason")
  riskFlags          String[]           @default([]) @map("risk_flags")
  providerName       String?            @map("provider_name")
  providerReference  String?            @map("provider_reference")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents KycDocument[]
  reviews   KycReview[]

  @@index([status, submittedAt])
  @@index([idDocumentNumber])
  @@map("kyc_profiles")
}

model KycDocument {
  id              String            @id @default(uuid()) @db.Uuid
  kycProfileId    String            @map("kyc_profile_id") @db.Uuid
  type            KycDocumentType
  status          KycDocumentStatus @default(PENDING)
  /// Clé opaque du fichier chiffré (AES-256-GCM) dans le stockage privé.
  storageKey      String            @unique @map("storage_key")
  mimeType        String            @map("mime_type")
  sizeBytes       Int               @map("size_bytes")
  sha256          String
  scanStatus      String            @default("NOT_SCANNED") @map("scan_status")
  rejectionReason String?           @map("rejection_reason")
  uploadedById    String            @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  replacedAt      DateTime?         @map("replaced_at")

  kycProfile KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Restrict)

  @@index([kycProfileId, type])
  @@map("kyc_documents")
}

/// Historique immuable des décisions (UPDATE/DELETE bloqués par trigger).
model KycReview {
  id               String            @id @default(uuid()) @db.Uuid
  kycProfileId     String            @map("kyc_profile_id") @db.Uuid
  reviewerId       String            @map("reviewer_id") @db.Uuid
  decision         KycReviewDecision
  reason           String?
  internalNotes    String?           @map("internal_notes")
  submissionNumber Int               @map("submission_number")
  documentDecisions Json?            @map("document_decisions")
  createdAt        DateTime          @default(now()) @map("created_at")

  kycProfile KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Restrict)

  @@index([kycProfileId, createdAt])
  @@map("kyc_reviews")
}

// ─────────────────────────────── RBAC ───────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // SUPER_ADMIN, ADMIN, FINANCE, OPS, COMPLIANCE, PROGRAM, RISK, CLAIMS, MEMBER
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // ex. wallet.read.self, admin.drivers.read
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ─────────────────────────────── Sessions & appareils ───────────────────────────────

model Device {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  installationId String    @map("installation_id") // UUID généré par l'application
  platform       String // android, web, ios
  model          String?
  appVersion     String?   @map("app_version")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions Session[]

  @@unique([userId, installationId])
  @@map("devices")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid // chaîne de rotation des refresh tokens
  refreshTokenHash String    @unique @map("refresh_token_hash") // SHA-256, jamais le token en clair
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason") // ROTATED, LOGOUT, REUSE_DETECTED, ADMIN, DEVICE_REVOKED
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  ipHash           String?   @map("ip_hash")
  userAgent        String?   @map("user_agent")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

enum OtpPurpose {
  REGISTER
  PIN_RESET
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  phone       String
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") // HMAC-SHA256
  attempts    Int        @default(0)
  maxAttempts Int        @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt])
  @@map("otp_challenges")
}

// ─────────────────────────────── Audit ───────────────────────────────

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorType    String   @map("actor_type") // MEMBER, STAFF, SYSTEM
  action       String // ex. auth.login.succeeded, ledger.transaction.posted
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  before       Json?
  after        Json?
  metadata     Json?
  requestId    String?  @map("request_id")
  ipHash       String?  @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────── Ledger en partie double ───────────────────────────────

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryDirection {
  DEBIT
  CREDIT
}

model LedgerAccount {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique // ex. member:<uuid>:available, system:provider_clearing:sandbox
  name          String
  type          LedgerAccountType
  purpose       String // MEMBER_AVAILABLE, MEMBER_RESERVED, PROVIDER_CLEARING, CONTRIBUTION_POOL, FEES_REVENUE…
  currency      String            @default("XAF") @db.Char(3)
  ownerUserId   String?           @map("owner_user_id") @db.Uuid
  // Solde dans le sens normal du compte (crédit pour LIABILITY/EQUITY/REVENUE, débit pour ASSET/EXPENSE).
  // Cache contrôlé : modifié uniquement par LedgerService dans la même transaction que les écritures,
  // vérifiable à tout moment par recalcul depuis ledger_entries.
  balance       Decimal           @default(0) @db.Decimal(20, 2)
  allowNegative Boolean           @default(false) @map("allow_negative")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  entries LedgerEntry[]

  @@index([ownerUserId])
  @@index([purpose])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  reference    String   @unique // référence métier idempotente : un même mouvement ne peut être posté deux fois
  type         String // DEPOSIT, CONTRIBUTION, ASSISTANCE, REVERSAL…
  description  String?
  currency     String   @db.Char(3)
  reversalOfId String?  @unique @map("reversal_of_id") @db.Uuid
  metadata     Json?
  createdById  String?  @map("created_by_id") @db.Uuid
  postedAt     DateTime @default(now()) @map("posted_at")

  reversalOf LedgerTransaction?  @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy LedgerTransaction?  @relation("Reversal")
  entries    LedgerEntry[]

  @@index([type])
  @@index([postedAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String         @id @default(uuid()) @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  direction     EntryDirection
  amount        Decimal        @db.Decimal(20, 2)
  currency      String         @db.Char(3)
  balanceAfter  Decimal        @map("balance_after") @db.Decimal(20, 2)
  createdAt     DateTime       @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ─────────────────────────────── Wallet ───────────────────────────────

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

model Wallet {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  currency           String       @default("XAF") @db.Char(3)
  status             WalletStatus @default(ACTIVE)
  availableAccountId String       @unique @map("available_account_id") @db.Uuid
  reservedAccountId  String       @unique @map("reserved_account_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

// ─────────────────────────────── Idempotence ───────────────────────────────

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  ownerKey       String            @map("owner_key") // user id, ou "anonymous"
  scope          String // ex. POST /v1/payments/intents
  key            String // en-tête Idempotency-Key (UUID)
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at")
  expiresAt      DateTime          @map("expires_at")

  @@unique([ownerKey, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─────────────────────────────── Paiements ───────────────────────────────
// Cycle : CREATED → PENDING (chez l'opérateur) → SUCCEEDED | FAILED | CANCELLED | EXPIRED.
// Seul SUCCEEDED crédite le portefeuille, par une écriture au ledger de référence « payment:<id> ».

enum PaymentIntentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

model PaymentIntent {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  walletId            String              @map("wallet_id") @db.Uuid
  provider            String
  channel             String // MTN_MOMO, ORANGE_MONEY
  amount              Decimal             @db.Decimal(20, 2)
  fee                 Decimal             @default(0) @db.Decimal(20, 2)
  currency            String              @db.Char(3)
  status              PaymentIntentStatus @default(CREATED)
  payerPhone          String              @map("payer_phone")
  externalReference   String?             @unique @map("external_reference")
  payerInstructions   String?             @map("payer_instructions")
  idempotencyKey      String              @map("idempotency_key")
  failureCode         String?             @map("failure_code")
  failureMessage      String?             @map("failure_message")
  ledgerTransactionId String?             @unique @map("ledger_transaction_id") @db.Uuid
  expiresAt           DateTime            @map("expires_at")
  confirmedAt         DateTime?           @map("confirmed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@map("payment_intents")
}

/// Webhooks opérateur enregistrés avant traitement ; (provider, event_id) unique = déduplication.
model PaymentWebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String
  eventId           String    @map("event_id")
  externalReference String    @map("external_reference")
  status            String
  payload           Json
  receivedAt        DateTime  @default(now()) @map("received_at")
  processedAt       DateTime? @map("processed_at")
  processingError   String?   @map("processing_error")

  @@unique([provider, eventId])
  @@index([externalReference])
  @@map("payment_webhook_events")
}

// ─────────────────────────────── Contributions ───────────────────────────────
// 200 FCFA par jour (montant configurable). Une contribution au plus par membre et par jour (contrainte unique) :
// une requête répétée ne peut jamais débiter deux fois. Chaque contribution est adossée à une écriture du ledger.

enum ContributionPlanStatus {
  ACTIVE
  PAUSED
}

enum ContributionSource {
  MANUAL
  AUTO
}

model ContributionPlan {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @unique @map("user_id") @db.Uuid
  amount    Decimal                @db.Decimal(20, 2)
  currency  String                 @default("XAF") @db.Char(3)
  frequency String                 @default("DAILY")
  autoDebit Boolean                @default(false) @map("auto_debit")
  status    ContributionPlanStatus @default(ACTIVE)
  /// Premier jour dû (fuseau Africa/Douala).
  startedOn DateTime               @map("started_on") @db.Date
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  contributions Contribution[]

  @@index([status, autoDebit])
  @@map("contribution_plans")
}

/// Contribution payée pour un jour donné. Immuable (trigger) : c'est une trace financière.
model Contribution {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  planId              String             @map("plan_id") @db.Uuid
  periodDate          DateTime           @map("period_date") @db.Date
  amount              Decimal            @db.Decimal(20, 2)
  currency            String             @db.Char(3)
  source              ContributionSource
  ledgerTransactionId String             @unique @map("ledger_transaction_id") @db.Uuid
  paidAt              DateTime           @default(now()) @map("paid_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan ContributionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([userId, periodDate])
  @@index([periodDate])
  @@map("contributions")
}

/// Exécutions des tâches quotidiennes (prélèvement automatique, rappels) : une par jour et par type.
model ContributionRun {
  id         String    @id @default(uuid()) @db.Uuid
  periodDate DateTime  @map("period_date") @db.Date
  kind       String // AUTO_DEBIT, REMINDER
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  processed  Int       @default(0)
  succeeded  Int       @default(0)
  failed     Int       @default(0)

  @@unique([periodDate, kind])
  @@map("contribution_runs")
}

// ─────────────────────────────── Tirages et bénéficiaires ───────────────────────────────
// Tirage vérifiable publiquement (cahier §11) :
//   1. gel : liste figée des éligibles, jetons anonymes, empreinte SHA-256 de la liste, engagement SHA-256 sur une graine secrète ;
//   2. exécution : score = SHA-256(graine ‖ jeton), les N plus petits scores gagnent (aucun doublon possible) ;
//   3. publication (par un second administrateur) : révélation de la graine ; chacun peut tout recalculer sans donnée personnelle.

enum DrawStatus {
  DRAFT
  FROZEN
  EXECUTED
  PUBLISHED
  CANCELLED
}

model Draw {
  id               String     @id @default(uuid()) @db.Uuid
  code             String     @unique
  title            String
  scheduledAt      DateTime   @map("scheduled_at")
  winnerCount      Int        @map("winner_count")
  /// Critères d'éligibilité figés à la création : { windowDays, minPaidDays }.
  minPaidDays      Int        @map("min_paid_days")
  windowDays       Int        @map("window_days")
  status           DrawStatus @default(DRAFT)
  algorithmVersion String     @default("sha256-rank-v1") @map("algorithm_version")
  snapshotAt       DateTime?  @map("snapshot_at")
  eligibleCount    Int?       @map("eligible_count")
  snapshotHash     String?    @map("snapshot_hash")
  seedCommitment   String?    @map("seed_commitment")
  /// Graine secrète (hex) : jamais exposée avant la publication.
  seed             String?
  resultHash       String?    @map("result_hash")
  executedAt       DateTime?  @map("executed_at")
  publishedAt      DateTime?  @map("published_at")
  cancelledAt      DateTime?  @map("cancelled_at")
  cancelReason     String?    @map("cancel_reason")
  createdById      String     @map("created_by_id") @db.Uuid
  frozenById       String?    @map("frozen_by_id") @db.Uuid
  executedById     String?    @map("executed_by_id") @db.Uuid
  publishedById    String?    @map("published_by_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  entries       DrawEntry[]
  winners       DrawWinner[]
  beneficiaries Beneficiary[]

  @@index([status, scheduledAt])
  @@map("draws")
}

/// Participant figé au gel du tirage. Immuable (trigger).
model DrawEntry {
  id               String   @id @default(uuid()) @db.Uuid
  drawId           String   @map("draw_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  /// Jeton public anonyme (HMAC) : permet la vérification sans révéler l'identité.
  participantToken String   @map("participant_token")
  paidDays         Int      @map("paid_days")
  createdAt        DateTime @default(now()) @map("created_at")

  draw   Draw        @relation(fields: [drawId], references: [id], onDelete: Restrict)
  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  winner DrawWinner?

  @@unique([drawId, userId])
  @@unique([drawId, participantToken])
  @@map("draw_entries")
}

/// Gagnant d'un tirage exécuté. Immuable (trigger).
model DrawWinner {
  id        String   @id @default(uuid()) @db.Uuid
  drawId    String   @map("draw_id") @db.Uuid
  entryId   String   @unique @map("entry_id") @db.Uuid
  rank      Int
  score     String
  createdAt DateTime @default(now()) @map("created_at")

  draw  Draw      @relation(fields: [drawId], references: [id], onDelete: Restrict)
  entry DrawEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([drawId, rank])
  @@map("draw_winners")
}

enum BeneficiaryStatus {
  SELECTED
  TRAINING
  CERTIFIED
  ENTREPRENEUR
  WITHDRAWN
}

model Beneficiary {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  drawId      String            @map("draw_id") @db.Uuid
  status      BeneficiaryStatus @default(SELECTED)
  mentorName  String?           @map("mentor_name")
  selectedAt  DateTime          @default(now()) @map("selected_at")
  statusNote  String?           @map("status_note")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  draw Draw @relation(fields: [drawId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("beneficiaries")
}

// ─────────────────────────────── Notifications ───────────────────────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String // PAYMENT_SUCCEEDED, CONTRIBUTION_DUE, DRAW_RESULT, KYC_DECISION…
  title     String
  body      String
  deepLink  String?   @map("deep_link")
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// ─────────────────────────────── Formation & LMS ───────────────────────────────

enum LessonContentType {
  AUDIO
  TEXT
  VIDEO
}

model CourseModule {
  id              String   @id @default(uuid()) @db.Uuid
  month           Int      @unique // 1 à 6
  title           String
  description     String
  durationMinutes Int      @default(120) @map("duration_minutes")
  order           Int      @default(1)
  iconName        String?  @map("icon_name")
  createdAt       DateTime @default(now()) @map("created_at")

  lessons CourseLesson[]
  quizzes Quiz[]

  @@map("course_modules")
}

model CourseLesson {
  id              String            @id @default(uuid()) @db.Uuid
  moduleId        String            @map("module_id") @db.Uuid
  title           String
  description     String?
  durationMinutes Int               @default(15) @map("duration_minutes")
  contentType     LessonContentType @default(AUDIO) @map("content_type")
  audioUrl        String?           @map("audio_url")
  markdownContent String            @map("markdown_content") @db.Text
  keyPoints       Json?             @map("key_points")
  order           Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at")

  module   CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress UserLessonProgress[]

  @@index([moduleId, order])
  @@map("course_lessons")
}

model UserLessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_lesson_progress")
}

model Quiz {
  id          String   @id @default(uuid()) @db.Uuid
  moduleId    String   @map("module_id") @db.Uuid
  title       String
  passScore   Int      @default(70) @map("pass_score") // Pourcentage requis (ex. 70%)
  createdAt   DateTime @default(now()) @map("created_at")

  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@map("quizzes")
}

model QuizQuestion {
  id          String   @id @default(uuid()) @db.Uuid
  quizId      String   @map("quiz_id") @db.Uuid
  question    String
  options     Json // ["Option A", "Option B", "Option C"]
  correctIndex Int     @map("correct_index")
  explanation String?
  order       Int      @default(1)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  quizId    String   @map("quiz_id") @db.Uuid
  score     Int // Pourcentage (0-100)
  passed    Boolean
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@map("quiz_submissions")
}

model Certification {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  certificateNumber String   @unique @map("certificate_number")
  title             String   @default("Certificat d'Entrepreneur Benskin Impact")
  issuedAt          DateTime @default(now()) @map("issued_at")
  verificationHash  String   @unique @map("verification_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certifications")
}

// ─────────────────────────────── Projets & Entrepreneuriat ───────────────────────────────

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  FUNDED
}

model Project {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  title                String
  sector               String
  city                 String
  locationDetail       String?       @map("location_detail")
  estimatedBudget      Decimal       @map("estimated_budget") @db.Decimal(20, 2)
  personalContribution Decimal       @default(0) @map("personal_contribution") @db.Decimal(20, 2)
  grantRequested       Decimal       @map("grant_requested") @db.Decimal(20, 2)
  status               ProjectStatus @default(DRAFT)
  description          String        @db.Text
  businessPlan         Json?         @map("business_plan")
  reviewFeedback       String?       @map("review_feedback")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  milestones    ProjectMilestone[]
  disbursements ProjectDisbursement[]

  @@index([userId, status])
  @@map("projects")
}

model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  targetDate  DateTime? @map("target_date")
  amount      Decimal   @db.Decimal(20, 2)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_milestones")
}

model ProjectDisbursement {
  id                  String    @id @default(uuid()) @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  amount              Decimal   @db.Decimal(20, 2)
  currency            String    @default("XAF") @db.Char(3)
  status              String    @default("PENDING") // PENDING, DISBURSED
  ledgerTransactionId String?   @unique @map("ledger_transaction_id") @db.Uuid
  disbursedAt         DateTime? @map("disbursed_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@map("project_disbursements")
}

// ─────────────────────────────── Accidents & Solidarité ───────────────────────────────

enum AccidentSeverity {
  LIGHT
  MODERATE
  SEVERE
}

enum AccidentClaimStatus {
  SUBMITTED
  INVESTIGATING
  APPROVED
  REJECTED
  DISBURSED
}

enum AccidentDocType {
  BULLETIN_ENTREE
  ORDONNANCE
  FACTURE_HOPITAL
  CONSTAT_POLICE
  PHOTO_MOTO
}

model AccidentClaim {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  reference           String              @unique // ex. ACC-2026-0001
  date                DateTime
  location            String
  severity            AccidentSeverity    @default(MODERATE)
  thirdPartyInvolved  Boolean             @default(false) @map("third_party_involved")
  hospitalName        String?             @map("hospital_name")
  description         String              @db.Text
  status              AccidentClaimStatus @default(SUBMITTED)
  requestedAmount     Decimal             @map("requested_amount") @db.Decimal(20, 2)
  approvedAmount      Decimal?            @map("approved_amount") @db.Decimal(20, 2)
  reviewNotes         String?             @map("review_notes")
  ledgerTransactionId String?             @unique @map("ledger_transaction_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents ClaimDocument[]

  @@index([userId, status])
  @@map("accident_claims")
}

model ClaimDocument {
  id         String          @id @default(uuid()) @db.Uuid
  claimId    String          @map("claim_id") @db.Uuid
  type       AccidentDocType
  storageKey String          @unique @map("storage_key")
  mimeType   String          @map("mime_type")
  sizeBytes  Int             @map("size_bytes")
  createdAt  DateTime        @default(now()) @map("created_at")

  claim AccidentClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("claim_documents")
}

// ─────────────────────────────── Recrutement & Partenariats ───────────────────────────────

model JobOffer {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  company      String
  sector       String
  location     String
  salaryHint   String?  @map("salary_hint")
  requirements String?
  description  String   @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  applications JobApplication[]

  @@map("job_offers")
}

enum JobApplicationStatus {
  PENDING
  SHORTLISTED
  CONTACTED
  HIRED
}

model JobApplication {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  jobOfferId String               @map("job_offer_id") @db.Uuid
  status     JobApplicationStatus @default(PENDING)
  message    String?
  createdAt  DateTime             @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@unique([userId, jobOfferId])
  @@map("job_applications")
}

// ─────────────────────────────── Paramètres Système ───────────────────────────────

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // ex. accidents.solidarity_debit_amount
  value       String   // valeur sérialisée (nombre, JSON, etc.)
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}
