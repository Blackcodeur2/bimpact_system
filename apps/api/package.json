{
  "name": "@benskin/api",
  "version": "0.1.0",
  "private": true,
  "description": "BENSKIN IMPACT — API NestJS",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "db": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js",
    "prisma:generate": "pnpm db generate",
    "prisma:migrate": "pnpm db migrate dev",
    "prisma:deploy": "pnpm db migrate deploy",
    "prisma:seed": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only prisma/seed.ts",
    "kyc:dev": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only scripts/kyc-review-dev.ts",
    "draw:dev": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only scripts/draw-dev.ts",
    "training:seed": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only scripts/seed-modules-data.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.2",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "setupFiles": ["reflect-metadata"],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.ts$": "ts-jest" },
    "collectCoverageFrom": ["**/*.ts", "!main.ts"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
